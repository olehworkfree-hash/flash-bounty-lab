@@ -0,0 +1,11 @@
+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.24;
+
+/// @notice Discrete local-fork test amounts. Not an on-chain risk policy.
+library TriangleAmounts {
+    function allowed(uint256 n) internal pure returns (bool) {
+        return n == 1e12 || n == 1e13 || n == 5e13 || n == 1e14
+            || n == 2e14 || n == 5e14 || n == 1e15 || n == 1e16
+            || n == 1e17 || n == 1e18;
+    }
+}
diff --git a/test/TriangleAmounts.t.sol b/test/TriangleAmounts.t.sol
new file mode 100644
index 0000000..ac89d7e
--- /dev/null
+++ b/test/TriangleAmounts.t.sol
@@ -0,0 +1,30 @@
+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.24;
+import {TriangleAmounts} from "../src/TriangleAmounts.sol";
+
+contract TriangleAmountsTest {
+    function testAllTenAmounts() public pure {
+        uint256[10] memory sizes = [uint256(1e12),1e13,5e13,1e14,2e14,5e14,1e15,1e16,1e17,1e18];
+        for (uint256 i; i < sizes.length; ++i) {
+            require(TriangleAmounts.allowed(sizes[i]),"ALLOWLIST");
+            require(sizes[i] % 10000 == 0,"EXACT_PREMIUM");
+        }
+    }
+    function testZeroAndHugeDenied() public pure {
+        require(!TriangleAmounts.allowed(0));
+        require(!TriangleAmounts.allowed(type(uint256).max));
+        require(!TriangleAmounts.allowed(1e18+1));
+    }
+    function testNeighboursDenied() public pure {
+        uint256[10] memory sizes = [uint256(1e12),1e13,5e13,1e14,2e14,5e14,1e15,1e16,1e17,1e18];
+        for (uint256 i; i < sizes.length; ++i) {
+            require(!TriangleAmounts.allowed(sizes[i]-1));
+            require(!TriangleAmounts.allowed(sizes[i]+1));
+        }
+    }
+    function testFuzzAcceptedAmountsStayBounded(uint256 n) public pure {
+        if (TriangleAmounts.allowed(n)) {
+            require(n >= 1e12 && n <= 1e18 && n % 10000 == 0);
+        }
+    }
+}
