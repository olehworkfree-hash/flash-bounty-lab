+"""Finite research-only triangle sizing; all sizes are WETH base units.
+
+The four legacy amounts are retained; six sub-grid probes are added. This is
+not an optimizer, a continuous-amount bound, or an execution authorization.
+Each amount is divisible by 10_000 so integer-bps flash premiums are exact.
+"""
+LEGACY_SIZES = (10**15, 10**16, 10**17, 10**18)
+MICRO_SIZES = (10**12, 10**13, 5*10**13, 10**14, 2*10**14, 5*10**14)
+SIZES = tuple(sorted(LEGACY_SIZES + MICRO_SIZES))
+MAX_ROUTES = 2 * 4**3 * len(SIZES)
+SIZING_SCOPE = 'TEN_DISCRETE_AMOUNTS_NOT_ALL_AMOUNTS'
