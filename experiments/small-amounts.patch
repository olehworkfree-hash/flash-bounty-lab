+import copy
+from pathlib import Path
+import re
+import unittest
+from triangle_amounts import LEGACY_SIZES, MICRO_SIZES, SIZES, MAX_ROUTES, SIZING_SCOPE
+from triangle_screen import encode_quote, words, WETH, USDC, USDCE, build_routes, premium, digest
+from test_triangle import mock_pools, fixture, seal
+from run_triangle_fork import validate_selection
+from triangle_bounds import bound_routes
+from test_triangle_bounds import pools
+
+class TriangleAmountTests(unittest.TestCase):
+    def test_exact_ten_sorted_unique(self):
+        self.assertEqual(len(SIZES),10)
+        self.assertEqual(SIZES,tuple(sorted(set(SIZES))))
+    def test_legacy_sizes_preserved(self):
+        self.assertEqual(LEGACY_SIZES,(10**15,10**16,10**17,10**18))
+        self.assertTrue(set(LEGACY_SIZES)<=set(SIZES))
+    def test_micro_smaller_not_zero(self):
+        self.assertTrue(all(0 < n < min(LEGACY_SIZES) for n in MICRO_SIZES))
+    def test_all_amounts_have_exact_bps_premium(self):
+        for n in SIZES:
+            for bps in (0,1,5,17,9999,10000):
+                self.assertEqual(n*bps%10000,0)
+                self.assertEqual(premium(n,bps),n*bps//10000)
+    def test_all_amounts_encode_exactly(self):
+        for n in SIZES:
+            raw=bytes.fromhex(encode_quote([WETH,USDC,USDCE,WETH],[100,500,3000],n)[2:])
+            self.assertEqual(int.from_bytes(raw[36:68],'big'),n)
+    def test_unlisted_and_bad_types_rejected(self):
+        for n in (True,False,'1000000000000',1e12,0,1,-1,10**18+1,10**12-1):
+            with self.assertRaises(ValueError):
+                encode_quote([WETH,USDC,USDCE,WETH],[100,500,3000],n)
+    def test_complete_discrete_grid_count(self):
+        rows=build_routes(mock_pools())
+        self.assertEqual(len(rows),1280)
+        self.assertEqual(MAX_ROUTES,1280)
+        self.assertEqual({int(r['amount_in']) for r in rows},set(SIZES))
+    def test_solidity_python_allowlists_agree(self):
+        text=(Path(__file__).resolve().parents[1]/'src/TriangleAmounts.sol').read_text()
+        solidity={int(a)*10**int(b) for a,b in re.findall(r'n == (\d+)e(\d+)',text)}
+        self.assertEqual(solidity,set(SIZES))
+    def test_bounds_cover_all_twenty_mock_routes(self):
+        rows=bound_routes(pools(),5)
+        self.assertEqual(len(rows),20)
+        self.assertTrue(all(r['bound_pruned'] for r in rows))
+    def test_fork_selection_accepts_each_micro_amount(self):
+        for n in MICRO_SIZES:
+            q,s=fixture();r=s['observations']['rows'][0]
+            r.update(amount_in=str(n),amount_out=str(n-1),premium_wei=str(premium(n,5)),gross_before_gas_wei=str(-1-premium(n,5)))
+            r.pop('candidate_id');r['candidate_id']=digest(dict(block_hash=q['header']['hash'],route=r))
+            s['matched_fork_selection']=[copy.deepcopy(r)];seal(s)
+            self.assertEqual(validate_selection(q,s,1001)[3][0]['amount_in'],str(n))
+    def test_scope_does_not_claim_continuous_optimization(self):
+        self.assertEqual(SIZING_SCOPE,'TEN_DISCRETE_AMOUNTS_NOT_ALL_AMOUNTS')
+    def test_two_hop_v3_grid_not_silently_changed(self):
+        import v3_market_screen as v
+        self.assertEqual(tuple(v.SIZES),LEGACY_SIZES)
+
+if __name__=='__main__':unittest.main()
